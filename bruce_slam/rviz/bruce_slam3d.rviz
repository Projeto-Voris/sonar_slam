Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Axes: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 100
      Name: StateEstimationOdom
      Topic:
        Value: /state_estimation/odom
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 100
      Name: SLAMOdom
      Topic:
        Value: /slam/odom
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: SLAMPath
      Topic:
        Value: /slam/path
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: SonarFiltered
      Topic:
        Value: /sonar_3d/points_filtered
      Size (m): 0.05
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: SLAMMapPoints
      Topic:
        Value: /slam/map_points
      Size (m): 0.08
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
Window Geometry:
  Height: 800
  Width: 1200
